# Environment variables example for NabiOta Health Group Germany
NEXT_PUBLIC_SITE_URL=https://www.nabiota-health-group.de
NEXT_PUBLIC_DEFAULT_LOCALE=de

# Supabase Cloud Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Fallback Admin Credentials (works immediately without Supabase setup)
ADMIN_EMAIL=admin@nabiota-health-group.de
ADMIN_PASSWORD=admin123
